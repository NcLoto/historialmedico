# Copie este archivo como .env y ajuste los valores. .env no debe versionarse.
APP_BASE_PATH=/historialmedico
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanitas_hme
DB_USERNAME=root
DB_PASSWORD=

# Solo para database/install.php. Si se dejan vacías se generan al azar y se muestran una sola vez.
ADMIN_EMAIL=admin@sanitas.local
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Clave secreta para firmar enlaces (bajas de correo). Genere una al azar: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# URL pública del sistema, usada en los enlaces de los correos
APP_URL=http://localhost/historialmedico

# Correo saliente. MAIL_DRIVER: archivo (guarda los correos en storage/mail, no envía), smtp o desactivado
MAIL_DRIVER=archivo
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
# MAIL_ENCRYPTION: tls (STARTTLS, puerto 587), ssl (puerto 465) o ninguno
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notificaciones@hospital.ejemplo
MAIL_FROM_NAME=Hospital Sanitas
